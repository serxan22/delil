# DƏLİL local development settings. Copy to .env:  cp .env.example .env
# These values are for a laptop. Never reuse them anywhere else.

# PostgreSQL owner (migrations) and least-privilege runtime role passwords.
POSTGRES_PASSWORD=delil-local-dev-only-change-me
DELIL_DB_APP_PASSWORD=delil-app-local-dev-only-change-me

# Master key that wraps signing keys (32 bytes, base64). Leave empty in
# development: one is generated inside the delil-data volume. In production
# set it from a secret manager:  openssl rand -base64 32
DELIL_MASTER_KEY=

# First administrator. With an empty password a random one is generated and
# printed once in the api logs:  docker compose logs api | grep -A9 bootstrap
DELIL_BOOTSTRAP_ADMIN_EMAIL=admin@delil.local
DELIL_BOOTSTRAP_ADMIN_PASSWORD=

# Seed the "LegalFlow Demo" organization with a month of sample activity.
DELIL_DEMO_DATA=true

# Host ports (bound to 127.0.0.1).
DELIL_API_PORT=8080
DELIL_DASHBOARD_PORT=3000
POSTGRES_PORT=5432
